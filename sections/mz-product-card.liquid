{{ 'section-mz-product-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --mz-pc-padding-top: {{ section.settings.padding_top }}px;
    --mz-pc-padding-bottom: {{ section.settings.padding_bottom }}px;
    --mz-pc-padding-top-mobile: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --mz-pc-padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --mz-pc-card-bg: {{ section.settings.card_bg_color }};
  }
{%- endstyle -%}

{%- assign product_image_alt = section.settings.product_image.alt | escape -%}
{%- assign tag_blocks = section.blocks | where: 'type', 'tag' -%}

<div class="mz-pc color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="mz-pc__card">

      <!-- Left: Product image -->
      <div class="mz-pc__image-panel">
        {%- if section.settings.product_image != blank -%}
          {{
            section.settings.product_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              class: 'mz-pc__image',
              alt: product_image_alt,
              widths: '400, 600, 800, 1000, 1200'
          }}
        {%- else -%}
          <div class="mz-pc__image-placeholder">
            {{ 'image' | placeholder_svg_tag: 'mz-pc__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <!-- Right: Info -->
      <div class="mz-pc__info-panel">

        {%- if section.settings.heading != blank -%}
          <h2 class="mz-pc__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="mz-pc__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}

        {%- if tag_blocks.size > 0 -%}
          <div class="mz-pc__tags">
            {%- for block in tag_blocks -%}
              <span class="mz-pc__tag" {{ block.shopify_attributes }}>
                <svg class="mz-pc__tag-check" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <polyline points="1.5 6 4.5 9 10.5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ block.settings.label | escape }}
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="mz-pc__price">
          {%- if section.settings.price != blank -%}
            <span class="mz-pc__price-current">{{ section.settings.price | escape }}</span>
          {%- endif -%}
          {%- if section.settings.compare_price != blank -%}
            <span class="mz-pc__price-compare">{{ section.settings.compare_price | escape }}</span>
          {%- endif -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_url | default: '#' }}"
            class="mz-pc__btn"
          >
            {{ section.settings.button_label | escape }}
            <svg class="mz-pc__btn-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 15L15 5M15 5H8M15 5V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}

      </div><!-- /.mz-pc__info-panel -->

    </div><!-- /.mz-pc__card -->
  </div><!-- /.page-width -->
</div><!-- /.mz-pc -->

{% schema %}
{
  "name": "MZ \u2013 Product Card",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Product name",
      "default": "Luviwear Ultra Prime"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "F\u00fcr den Trail bereit. K\u00f6rperfreundlich. F\u00fcr lange Strecken gebaut."
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Current price",
      "default": "$100"
    },
    {
      "type": "text",
      "id": "compare_price",
      "label": "Compare-at price",
      "default": "$130"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Produkt anzeigen"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Info panel background",
      "default": "#1a3a5c"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Benefit tag",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tag label",
          "default": "Knieschmerzen"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MZ \u2013 Product Card",
      "blocks": [
        { "type": "tag", "settings": { "label": "Knieschmerzen" } },
        { "type": "tag", "settings": { "label": "H\u00fcftschmerzen" } },
        { "type": "tag", "settings": { "label": "R\u00fcckenschmerzen" } }
      ]
    }
  ]
}
{% endschema %}
