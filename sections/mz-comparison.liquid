{{ 'section-mz-comparison.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --mz-comp-outer-bg: {{ section.settings.outer_bg_color }};
    --mz-comp-inner-bg: {{ section.settings.inner_bg_color }};
    --mz-comp-border-color: {{ section.settings.border_color }};
    --mz-comp-icon-bg: {{ section.settings.icon_bg_color }};
    --mz-comp-padding-top: {{ section.settings.padding_top }}px;
    --mz-comp-padding-bottom: {{ section.settings.padding_bottom }}px;
    --mz-comp-padding-top-mobile: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --mz-comp-padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
{%- endstyle -%}

{%- assign problem_blocks  = section.blocks | where: 'type', 'problem' -%}
{%- assign solution_blocks = section.blocks | where: 'type', 'solution' -%}
{%- assign center_icon_alt = section.settings.center_icon.alt | escape -%}

<div class="mz-comparison">
  <div class="page-width">
    <div class="mz-comparison__inner">

      <!-- Centered section heading -->
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="mz-comparison__heading">
          {{ section.settings.heading | escape }}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}

      <div class="mz-comparison__body">

        <!-- ==========================
             LEFT: Problem column
             ========================== -->
        <div class="mz-comparison__col mz-comparison__col--left">
          {%- if section.settings.left_col_label != blank -%}
            <p class="mz-comparison__col-label">{{ section.settings.left_col_label | escape }}</p>
          {%- endif -%}

          {%- for block in problem_blocks -%}
            <div class="mz-comparison__card mz-comparison__card--problem" {{ block.shopify_attributes }}>
              <span class="mz-comparison__badge mz-comparison__badge--x" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"/>
                  <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
              </span>
              <div class="mz-comparison__card-content">
                {%- if block.settings.heading != blank -%}
                  <strong class="mz-comparison__card-heading">{{ block.settings.heading | escape }}</strong>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="mz-comparison__card-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- ==========================
             CENTER: Decorative connector
             ========================== -->
        <div class="mz-comparison__center" aria-hidden="true">

          <!-- Shoe icon circle -->
          <div class="mz-comparison__center-icon-wrap">
            {%- if section.settings.center_icon != blank -%}
              {{
                section.settings.center_icon
                | image_url: width: 120
                | image_tag:
                  loading: 'lazy',
                  alt: center_icon_alt,
                  class: 'mz-comparison__center-icon-img',
                  widths: '60, 90, 120'
              }}
            {%- else -%}
              <svg class="mz-comparison__center-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.66 10.98c-.36-.4-.83-.62-1.33-.62h-1.33V8.5A2.5 2.5 0 0016.5 6h-7A2.5 2.5 0 007 8.5v1.86h-1.33c-.5 0-.97.22-1.33.62-.36.4-.53.92-.47 1.45l.67 5.5c.11.9.87 1.57 1.8 1.57h12.32c.93 0 1.69-.67 1.8-1.57l.67-5.5c.06-.53-.11-1.05-.47-1.45zM9 8.5A.5.5 0 019.5 8h5a.5.5 0 01.5.5V10H9V8.5zm7.5 8h-9a.5.5 0 010-1h9a.5.5 0 010 1z"/>
              </svg>
            {%- endif -%}
          </div>

          <!-- Mobile-only: solution labels shown between problem/solution sections -->
          <div class="mz-comparison__mobile-solution-labels">
            {%- if section.settings.mobile_solution_label != blank -%}
              <span class="mz-comparison__mobile-label">{{ section.settings.mobile_solution_label | escape }}</span>
            {%- endif -%}
            {%- if section.settings.mobile_solution_heading != blank -%}
              <span class="mz-comparison__mobile-subheading">{{ section.settings.mobile_solution_heading | escape }}</span>
            {%- endif -%}
          </div>

          <!-- Left-side dots (one per problem) -->
          {%- if problem_blocks.size > 0 -%}
            <div class="mz-comparison__dots mz-comparison__dots--left">
              {%- for block in problem_blocks -%}
                <div class="mz-comparison__dot"></div>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <!-- Right-side dots (one per solution) -->
          {%- if solution_blocks.size > 0 -%}
            <div class="mz-comparison__dots mz-comparison__dots--right">
              {%- for block in solution_blocks -%}
                <div class="mz-comparison__dot"></div>
              {%- endfor -%}
            </div>
          {%- endif -%}

        </div>

        <!-- ==========================
             RIGHT: Solution column
             ========================== -->
        <div class="mz-comparison__col mz-comparison__col--right">
          {%- if section.settings.right_col_label != blank -%}
            <p class="mz-comparison__col-label">{{ section.settings.right_col_label | escape }}</p>
          {%- endif -%}

          {%- for block in solution_blocks -%}
            <div class="mz-comparison__card mz-comparison__card--solution" {{ block.shopify_attributes }}>
              <span class="mz-comparison__badge mz-comparison__badge--check" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <div class="mz-comparison__card-content">
                {%- if block.settings.heading != blank -%}
                  <strong class="mz-comparison__card-heading">{{ block.settings.heading | escape }}</strong>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="mz-comparison__card-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

      </div><!-- /.mz-comparison__body -->
    </div><!-- /.mz-comparison__inner -->
  </div><!-- /.page-width -->
</div><!-- /.mz-comparison -->

{% schema %}
{
  "name": "MZ – Comparison",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Fußschmerzen halten Sie zurück. Hier ist die Lösung."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Column labels"
    },
    {
      "type": "text",
      "id": "left_col_label",
      "label": "Left column label",
      "default": "Haben Sie Fußschmerzen?"
    },
    {
      "type": "text",
      "id": "right_col_label",
      "label": "Right column label",
      "default": "Die Luviwear-Lösung:"
    },
    {
      "type": "header",
      "content": "Mobile solution divider (shown between columns on mobile)"
    },
    {
      "type": "text",
      "id": "mobile_solution_label",
      "label": "Small label text",
      "default": "Die Luviwear-Lösung",
      "info": "Shown in uppercase above the subheading on mobile"
    },
    {
      "type": "text",
      "id": "mobile_solution_heading",
      "label": "Subheading text",
      "default": "Für mehr Komfort – jeden Schritt."
    },
    {
      "type": "header",
      "content": "Center icon"
    },
    {
      "type": "image_picker",
      "id": "center_icon",
      "label": "Center icon image",
      "info": "Shown inside the circle. Use a white or light PNG/SVG on a dark background."
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon circle background",
      "default": "#0d2d5e"
    },
    {
      "type": "header",
      "content": "Background & border"
    },
    {
      "type": "color",
      "id": "outer_bg_color",
      "label": "Outer background color",
      "default": "#e8f0fe"
    },
    {
      "type": "color",
      "id": "inner_bg_color",
      "label": "Inner card background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Dashed border color",
      "default": "#4285f4"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem (left side)",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Lange Stunden auf den Beinen"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Langes Stehen oder Gehen belastet Ihre Gelenke und Muskeln."
        }
      ]
    },
    {
      "type": "solution",
      "name": "Solution (right side)",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Druckentlastende Polsterung"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Absorbiert Stöße, um Stress auf Füße, Knie und Gelenke zu reduzieren."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MZ – Comparison",
      "blocks": [
        { "type": "problem",  "settings": { "heading": "Lange Stunden auf den Beinen",           "text": "Langes Stehen oder Gehen belastet Ihre Gelenke und Muskeln." } },
        { "type": "problem",  "settings": { "heading": "Fersenschmerzen & Plantarfasziitis",      "text": "Stechende Schmerzen bei jedem Schritt, besonders morgens." } },
        { "type": "problem",  "settings": { "heading": "Flache Füße / wenig Halt",               "text": "Zu wenig Halt verursacht Fehlstellungen & Schmerzen." } },
        { "type": "problem",  "settings": { "heading": "Enges, einschränkendes Schuhwerk",        "text": "Schmale Designs schränken die Bewegung ein und verursachen Druckstellen." } },
        { "type": "solution", "settings": { "heading": "Druckentlastende Polsterung",            "text": "Absorbiert Stöße, um Stress auf Füße, Knie und Gelenke zu reduzieren." } },
        { "type": "solution", "settings": { "heading": "Gezielte Fersenunterstützung",           "text": "Entwickelt, um Schmerzen und Belastungen bei jedem Schritt zu reduzieren." } },
        { "type": "solution", "settings": { "heading": "Integrierte Fußgewölbeunterstützung",    "text": "Fördert die richtige Ausrichtung und verbessert die allgemeine Körperhaltung." } },
        { "type": "solution", "settings": { "heading": "Breites, flexibles Design",              "text": "Gibt Ihren Zehen Raum, sich natürlich und ohne Einschränkung zu bewegen." } }
      ]
    }
  ]
}
{% endschema %}
