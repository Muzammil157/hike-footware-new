{{ 'section-mz-condition-list.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --mz-cond-padding-top: {{ section.settings.padding_top }}px;
    --mz-cond-padding-bottom: {{ section.settings.padding_bottom }}px;
    --mz-cond-padding-top-mobile: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --mz-cond-padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --mz-cond-image-radius: {% if section.settings.image_rounded %}1.2rem{% else %}0px{% endif %};
  }
{%- endstyle -%}

{%- assign feature_blocks = section.blocks | where: 'type', 'feature_item' -%}
{%- assign image_alt = section.settings.image.alt | escape -%}

<div class="mz-cond color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="mz-cond__grid">

      <!-- ========================
           LEFT: Heading + Text + List
           ======================== -->
      <div class="mz-cond__left">

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="mz-cond__heading">
            {{ section.settings.heading | escape }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.paragraph != blank -%}
          <div class="mz-cond__paragraph">{{ section.settings.paragraph }}</div>
        {%- endif -%}

        {%- if feature_blocks.size > 0 -%}
          <ul class="mz-cond__list" role="list">
            {%- for block in feature_blocks -%}
              <li class="mz-cond__item" {{ block.shopify_attributes }}>
                <span class="mz-cond__item-icon" aria-hidden="true">
                  {%- if block.settings.icon != blank -%}
                    {%- assign icon_alt = block.settings.icon.alt | escape -%}
                    {{
                      block.settings.icon
                      | image_url: width: 80
                      | image_tag:
                        loading: 'lazy',
                        alt: icon_alt,
                        widths: '40, 60, 80'
                    }}
                  {%- else -%}
                    <svg class="mz-cond__item-icon-placeholder" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2C8.5 2 6 5 6 8c0 4 6 13 6 13s6-9 6-13c0-3-2.5-6-6-6z"/>
                      <circle cx="12" cy="8" r="2"/>
                    </svg>
                  {%- endif -%}
                </span>
                <span class="mz-cond__item-label">{{ block.settings.label | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

      </div>

      <!-- ========================
           RIGHT: Image
           ======================== -->
      <div class="mz-cond__right">
        <div class="mz-cond__image-wrapper">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                alt: image_alt,
                widths: '400, 600, 800, 900',
                sizes: '(max-width: 749px) 100vw, 50vw'
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "MZ – Condition List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hilfe bei alltäglichen Beschwerden"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Description",
      "default": "<p>Gesunde Füße sind die Grundlage für gesunde Bewegungen. Uviwear-Schuhe unterstützen die natürliche Bewegung und helfen Ihrem Körper, sich neu auszurichten und sich mühelos zu bewegen.</p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "image_rounded",
      "label": "Rounded corners",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Condition item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image",
          "info": "Small icon displayed beside the label. Use a square PNG or SVG."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Fußschmerzen"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MZ – Condition List",
      "blocks": [
        { "type": "feature_item", "settings": { "label": "Fußschmerzen" } },
        { "type": "feature_item", "settings": { "label": "Plantarfasziitis" } },
        { "type": "feature_item", "settings": { "label": "Diabetes" } },
        { "type": "feature_item", "settings": { "label": "Hallux Valgus" } },
        { "type": "feature_item", "settings": { "label": "Plattfüße" } }
      ]
    }
  ]
}
{% endschema %}
